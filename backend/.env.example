# Auth0 — use the SAME tenant domain and API Identifier as the frontend (.env.local).
# AUTH0_AUDIENCE must be your custom API "Identifier" (APIs in dashboard), NOT
# https://YOUR_TENANT.auth0.com/api/v2/ (Management API — wrong for this backend).
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://your-custom-api-identifier
AUTH0_ALGORITHMS=RS256

# Server
PORT=8000
PROXY_PORT=8513

# Optional: system chromedriver (Ubuntu: /usr/bin/chromedriver)
# CHROMEDRIVER_PATH=/usr/bin/chromedriver
