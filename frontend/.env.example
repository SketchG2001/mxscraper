# Backend (leave empty in dev to use Vite proxy to localhost:8000)
VITE_API_BASE_URL=

# Auth0 SPA — must match backend AUTH0_AUDIENCE for API tokens.
# Do NOT add Client Secret here; SPAs use PKCE only (public clients).
#
# In Auth0 → Applications → your SPA → Settings, set exactly:
#   Allowed Callback URLs:   http://localhost:5173
#   Allowed Logout URLs:     http://localhost:5173
#   Allowed Web Origins:     http://localhost:5173
# Run: npm run dev  (uses --strictPort so the origin never drifts)
#
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://your-api-identifier

# Authorize the SPA for your API in Auth0 first (see Layout banner / README flow), then optionally:
# VITE_AUTH0_AUDIENCE_ON_LOGIN=true
#
# If your API uses RBAC permissions (space-separated):
# VITE_AUTH0_API_SCOPE=read:stream

# Optional: only after enabling "Refresh Token Rotation" in Auth0 for this SPA:
# VITE_AUTH0_USE_REFRESH_TOKENS=true
#
# Allowed Callback / Logout / Web Origins: http://localhost:5173 (dev)

# Optional: override HLS proxy host (default: same host as API, from /health)
# VITE_PROXY_HOST=127.0.0.1

# Optional: Google AdSense (loads site-wide; no units inside the video player).
# Create display ad units in AdSense → Ads → By ad unit, then paste the client id and slot ids.
# Top slot is hidden on /watch/* and /player so ads never sit above the cinema player.
# VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# VITE_ADSENSE_SLOT_TOP=1234567890
# VITE_ADSENSE_SLOT_BOTTOM=0987654321
